# ==============================================================================
# Archon OS 2026 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or run setup.bat / ./install.sh) and adjust values.
# CRITICAL: Never commit .env or files containing real secrets to Git!

# --- 1. Server, Network & Paths ---
PORT=8501
HOST=0.0.0.0
# Security default: 127.0.0.1 (localhost only). Set 0.0.0.0 for LAN access.
ARCHON_BIND_IP=127.0.0.1
ARCHON_UID=1000
ARCHON_GID=1000
BASE_URL=http://localhost:8501
ARCHON_LANGUAGE=en
ARCHON_STACK_PROFILE=standard

# Data & Second-Brain Vault Paths (cross-platform defaults)
ARCHON_HERMES_DIR=./.hermes
ARCHON_OBSIDIAN_DIR=./obsidian_vault

# --- 2. Cloud LLM Providers (at least one API key OR local LLM recommended) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- 3. Local AI & Zero-Egress Privacy Routing (Ollama / LM Studio) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
LM_STUDIO_URL=http://host.docker.internal:1234/v1
PRIVACY_ZERO_EGRESS=false

# --- 4. OmniRoute & Hermes Hub (auto-populated with random secrets by install.sh) ---
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_CONTAINER_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_INITIAL_PASSWORD=
HERMES_SESSION_TOKEN=
HERMES_DASHBOARD_SESSION_TOKEN=

# --- 5. Optional Messaging & Channels ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 6. Optional External Tools & Services ---
POCKETBASE_URL=http://127.0.0.1:8090
N8N_URL=http://localhost:5678
N8N_USER_MANAGEMENT_JWT_SECRET=
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_VECTOR_DB=chroma
ANYTHINGLLM_EMBEDDING_ENGINE=native
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here
COMPOSIO_API_KEY=
GOOGLE_CREDENTIALS_FILE=data/secrets/google_credentials.json
GOOGLE_CALENDAR_ID=primary
GITHUB_TOKEN=
