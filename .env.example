# ==============================================================================
# Archon OS 2026 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or run setup.bat / ./install.sh) and adjust values.
# CRITICAL: Never commit .env or files containing real secrets to Git!

# --- 1. Server, Network & Paths ---
PORT=8501
HOST=0.0.0.0
# Security default: 127.0.0.1 (localhost only). Set 0.0.0.0 for LAN access.
ARCHON_BIND_IP=127.0.0.1
ARCHON_UID=1000
ARCHON_GID=1000
BASE_URL=http://localhost:8501
ARCHON_LANGUAGE=en
ARCHON_STACK_PROFILE=standard
# Observability-Profile (start.bat / install.sh): full = bestehende Profile
# monitoring + logging + replication starten zusaetzlich mit (prometheus,
# grafana, uptime-kuma, loki, promtail, litestream, alertmanager). off = Normal-Start.
ARCHON_OBSERVABILITY=off

# F-075: Langfuse/OTel-Export (optional). Leer = ehrlich "not_configured",
# lokale Trace-DB bleibt die Single Source of Truth. Fuers aktivierte
# Langfuse-Profil zusaetzlich LANGFUSE_DATABASE_URL, NEXTAUTH_SECRET und
# LANGFUSE_SALT ausfuellen (siehe docker-compose.yml).
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
# LANGFUSE_DATABASE_URL=
# NEXTAUTH_SECRET=
# LANGFUSE_SALT=

# Data & Second-Brain Vault Paths (cross-platform defaults)
ARCHON_HERMES_DIR=./.hermes
ARCHON_OBSIDIAN_DIR=./obsidian_vault

# --- 2. Cloud LLM Providers (at least one API key OR local LLM recommended) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- 3. Local AI & Zero-Egress Privacy Routing (Ollama / LM Studio) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
LM_STUDIO_URL=http://host.docker.internal:1234/v1
PRIVACY_ZERO_EGRESS=false

# --- 4. OmniRoute & Hermes Hub (auto-populated with random secrets by install.sh) ---
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_CONTAINER_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_INITIAL_PASSWORD=
HERMES_SESSION_TOKEN=
HERMES_DASHBOARD_SESSION_TOKEN=

# --- 5. Optional Messaging & Channels ---
# Leer = Telegram-Plugin bleibt deaktiviert (Adapter wird im Hermes-Container
# zwar gemountet, aber _is_connected() gate'd auf den Token). Die Datei selbst
# hat KEINEN Einfluss auf Archon-Performance — sie wird nie in den Archon-
# Prozess importiert. Zum Abschalten genügt, diesen Wert leer zu lassen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 6. Optional External Tools & Services ---
POCKETBASE_URL=http://127.0.0.1:8090
N8N_URL=http://localhost:5678
N8N_USER_MANAGEMENT_JWT_SECRET=
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_VECTOR_DB=chroma
ANYTHINGLLM_EMBEDDING_ENGINE=native
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here
COMPOSIO_API_KEY=
GOOGLE_CREDENTIALS_FILE=data/secrets/google_credentials.json
GOOGLE_CALENDAR_ID=primary
# Optionaler Pfad zur PocketBase-DB für den Restore-Test. Nur nötig, wenn
# PocketBase in einem eigenen Container-Volume läuft. Default:
# <Workspace>/pocketbase/pb_data/data.db. Fehlt die Datei, wird der Test
# übersprungen (SKIPPED), nicht als Fehler gewertet.
ARCHON_POCKETBASE_DB=
# Shared Secret für den lokalen Calendar-Aggregator (Port 8421). Muss sowohl
# vom Python-Microserver als auch vom Next.js-Proxy gesetzt sein. Leer = der
# Aggregator lehnt alle Anfragen ab (fail-closed). Nicht im LAN exponieren.
CALENDAR_AGGREGATOR_TOKEN=
GITHUB_TOKEN=

# --- 7. Audit-Kette (HMAC + externer Anker) ---
# HMAC-SHA256-Key für die Audit-Hashkette. Liegt NUR in der ENV, nicht in der
# DB und nicht im Backup. Leer = alte SHA-256-Kette (Rückwärtskompatibilität).
ARCHON_AUDIT_HMAC_KEY=
# Sichere Rotation: frühere Keys hier als JSON-Liste mit dem Block, ab dem sie
# galten, eintragen. Neuer Key oben + ARCHON_AUDIT_HMAC_EPOCH_FROM = erste
# Block-ID, die mit dem neuen Key signiert wird. Alte Blöcke bleiben so
# verifizierbar; fehlt ein Epochen-Key, schlägt verify_integrity() fehl
# (fail-closed). Beispiel: [{"key":"alter-wert","from_block":1}]
ARCHON_AUDIT_HMAC_EPOCHS=
ARCHON_AUDIT_HMAC_EPOCH_FROM=0
# Auth: lokale Entwicklung (127.0.0.1) bleibt offen. Bei 0.0.0.0 / LAN-IP oder
# ENVIRONMENT=production wird Auth ungeachtet settings.json erzwungen.
ENVIRONMENT=development
# Empfohlener Default: Auth erzwingen (auch im Development-Modus), sobald
# ARCHON_SERVICE_TOKEN / Admin-Zugang hinterlegt ist. false nur fuer isolierte
# lokale Entwicklung ohne LAN-Bindung. Leer = Compose-Default false.
ARCHON_REQUIRE_AUTH=true
# Self-Update: erlaubt dem Updater einen dokumentierten Container-Restart
# (`docker compose restart archon-os`) nach `git pull`. Default false = der
# Updater meldet nur `restart_required`, es wird nichts automatisch gestartet.
ARCHON_ALLOW_SELF_RESTART=false
# Append-only Anker der letzten Chain-Hash. Wird von einem Daemon-Thread alle
# 300 s geschrieben — kein Request-Pfad, kein Netzwerk (offline/Container-OK).
# Leer = Anker deaktiviert. Für echte Externalität auf ein NAS/Volume zeigen.
ARCHON_AUDIT_ANCHOR_PATH=./data/audit_anchor.log
# Audit D10 (24/7-Betrieb):
# Externer Dead-Man-Switch. Wird vom Selbstheilungsloop als heartbeat POST
# angesprochen; ohne URL bleibt Alerting stumm (Warnung im self-healing report).
ARCHON_HEARTBEAT_WEBHOOK_URL=
# Litestream-Replikat: im Produktivbetrieb auf EIN ANDERES Volume/NAS zeigen.
# RPO ~5-10 s (sync-interval), RTO = Zeit bis zum restore aus dem Replikat.
ARCHON_LITESTREAM_REPLICA_DIR=./data/litestream_replicas
