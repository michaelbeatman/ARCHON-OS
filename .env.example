# ==============================================================================
# Archon OS 2026 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or run setup.bat / ./install.sh) and adjust values.
# CRITICAL: Never commit .env or files containing real secrets to Git!

# --- 1. Server, Network & Paths ---
PORT=8501
HOST=0.0.0.0
# Security default: 127.0.0.1 (localhost only). Set 0.0.0.0 for LAN access.
ARCHON_BIND_IP=127.0.0.1
ARCHON_UID=1000
ARCHON_GID=1000
BASE_URL=http://localhost:8501
ARCHON_LANGUAGE=en
ARCHON_STACK_PROFILE=standard
# Observability-Profile (start.bat / install.sh / Ansible): full aktiviert die
# vier Einzelprofile monitoring, logging, replication und tracing — nicht
# `docker compose --profile full`. Damit starten prometheus, grafana,
# uptime-kuma, loki, promtail, litestream und der otel-collector. Alertmanager
# wird zusaetzlich nur bei gesetzten TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
# gestartet (sonst ehrlich `alerts_not_configured`). off = Normal-Start.
ARCHON_OBSERVABILITY=off

# Audit D09/D10 (D-D8): Langfuse v2 ist EOL und als startbares Artefakt aus
# Compose und den Startern entfernt. Ohne echte Werte bleibt die Statusmeldung
# ehrlich "not_configured". Die LANGFUSE_*-Werte unten dienen NUR dem optionalen
# OTLP-Export an eine extern betriebene, aktuelle Langfuse-Instanz — es gibt
# keinen lokalen Langfuse-Container mehr. Keine Defaults mit echten Keys.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Audit D16/P1: OTLP-Downstream des Collectors. Leer = nur `debug`-Exporter.
OTEL_DOWNSTREAM_OTLP_ENDPOINT=
ARCHON_OTEL_COLLECTOR_CONTAINER_NAME=archon-otel-collector
# Audit D16 (Agent I): Sampling im Collector. Audit-Spans setzen im Code
# force_sample_audit() und umgehen die Ratio bewusst.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Data & Second-Brain Vault Paths (cross-platform defaults)
ARCHON_HERMES_DIR=./.hermes
ARCHON_OBSIDIAN_DIR=./obsidian_vault
# Audit A3 (D09/H9): 28→3 Domänen-DB-Konsolidierung. Das Manifest ist versioniert
# unter config/db_consolidated.json (active:true, relative Pfade) und liegt damit
# nicht mehr im gitignored data/. Mit =1 ist die Konsolidierung auch ohne Manifest
# aktiv; 0 deaktiviert sie explizit. Kein Geheimnis — nur Laufzeit-Schalter.
ARCHON_DB_CONSOLIDATED=1

# --- 2. Cloud LLM Providers (at least one API key OR local LLM recommended) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# --- 3. Local AI & Zero-Egress Privacy Routing (Ollama / LM Studio) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
LM_STUDIO_URL=http://host.docker.internal:1234/v1
PRIVACY_ZERO_EGRESS=false

# --- 4. OmniRoute & Hermes Hub (auto-populated with random secrets by install.sh) ---
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_CONTAINER_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_INITIAL_PASSWORD=
HERMES_SESSION_TOKEN=
HERMES_DASHBOARD_SESSION_TOKEN=

# --- 5. Optional Messaging & Channels ---
# Leer = Telegram-Plugin bleibt deaktiviert (Adapter wird im Hermes-Container
# zwar gemountet, aber _is_connected() gate'd auf den Token). Die Datei selbst
# hat KEINEN Einfluss auf Archon-Performance — sie wird nie in den Archon-
# Prozess importiert. Zum Abschalten genügt, diesen Wert leer zu lassen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 6. Optional External Tools & Services ---
POCKETBASE_URL=http://127.0.0.1:8090
N8N_URL=http://localhost:5678
N8N_USER_MANAGEMENT_JWT_SECRET=
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_VECTOR_DB=chroma
ANYTHINGLLM_EMBEDDING_ENGINE=native
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here
COMPOSIO_API_KEY=
GOOGLE_CREDENTIALS_FILE=data/secrets/google_credentials.json
GOOGLE_CALENDAR_ID=primary
# Optionaler Pfad zur PocketBase-DB für den Restore-Test. Nur nötig, wenn
# PocketBase in einem eigenen Container-Volume läuft. Default:
# <Workspace>/pocketbase/pb_data/data.db. Fehlt die Datei, wird der Test
# übersprungen (SKIPPED), nicht als Fehler gewertet.
ARCHON_POCKETBASE_DB=
# Shared Secret für den lokalen Calendar-Aggregator (Port 8421). Muss sowohl
# vom Python-Microserver als auch vom Next.js-Proxy gesetzt sein. Leer = der
# Aggregator lehnt alle Anfragen ab (fail-closed). Nicht im LAN exponieren.
CALENDAR_AGGREGATOR_TOKEN=
GITHUB_TOKEN=

# --- 7. Audit-Kette (HMAC + externer Anker) ---
# HMAC-SHA256-Key für die Audit-Hashkette. Liegt NUR in der ENV, nicht in der
# DB und nicht im Backup. Leer = alte SHA-256-Kette (Rückwärtskompatibilität).
ARCHON_AUDIT_HMAC_KEY=
# Sichere Rotation: frühere Keys hier als JSON-Liste mit dem Block, ab dem sie
# galten, eintragen. Neuer Key oben + ARCHON_AUDIT_HMAC_EPOCH_FROM = erste
# Block-ID, die mit dem neuen Key signiert wird. Alte Blöcke bleiben so
# verifizierbar; fehlt ein Epochen-Key, schlägt verify_integrity() fehl
# (fail-closed). Beispiel: [{"key":"alter-wert","from_block":1}]
ARCHON_AUDIT_HMAC_EPOCHS=
ARCHON_AUDIT_HMAC_EPOCH_FROM=0
# Audit D05/D10 (F-01, D-D9): Produktion ist der Default-Deploy-Modus. Er
# schaltet die Audit-Fail-Closed-Pruefungen und den echten /readyz-Gate aktiv.
# Auth wird bei 0.0.0.0 / LAN-IP oder production ungeachtet settings.json
# erzwungen. Fuer bewusst isolierte lokale Entwicklung auf 127.0.0.1 darf
# ENVIRONMENT=development gesetzt werden — dann greift der explizite
# ARCHON_READINESS_PROBES=1 unten weiterhin fuer den Dependency-Gate.
ENVIRONMENT=production
# Erzwingt die externen /readyz-Probes (omniroute /models, n8n /healthz)
# unabhaengig von ENVIRONMENT. Default 1 = fail-closed in allen Startpfaden.
ARCHON_READINESS_PROBES=1
# Empfohlener Default: Auth erzwingen (auch im Development-Modus), sobald
# ARCHON_SERVICE_TOKEN / Admin-Zugang hinterlegt ist. false nur fuer isolierte
# lokale Entwicklung ohne LAN-Bindung. Leer = Compose-Default false.
ARCHON_REQUIRE_AUTH=true
# Self-Update: erlaubt dem Updater einen dokumentierten Container-Restart
# (`docker compose restart archon-os`) nach `git pull`. Default false = der
# Updater meldet nur `restart_required`, es wird nichts automatisch gestartet.
ARCHON_ALLOW_SELF_RESTART=false
# Append-only Anker der letzten Chain-Hash. Wird von einem Daemon-Thread alle
# 300 s geschrieben — kein Request-Pfad, kein Netzwerk (offline/Container-OK).
# Standard lokal auf ./data/audit_anchor.log; fuer echte physische Externalitaet
# auf ein separates, nur-append-faehiges Host-/NAS-Volume zeigen. Leer = aus.
ARCHON_AUDIT_ANCHOR_PATH=./data/audit_anchor.log
# Audit D10 (24/7-Betrieb):
# Externer Dead-Man-Switch. Wird vom Selbstheilungsloop als heartbeat POST
# angesprochen; ohne URL bleibt Alerting stumm (Warnung im self-healing report).
# Der echte Dead-Man-Switch ist die Prometheus-Metrik
# archon_heartbeat_timestamp_seconds (Regel: time() - ... > 300 → critical).
ARCHON_HEARTBEAT_WEBHOOK_URL=

# Externer Autoheal (archon-autoheal): startet IMMER mit — auch ohne
# Observability-Profile. Er ist die einzige Instanz ausserhalb des
# ueberwachten Event-Loops, die einen Hang erkennt und den Container
# tatsaechlich neu startet. Alle Werte haben sichere Defaults; nur bei
# abweichendem Verhalten anpassen.
AUTOHEAL_TARGET_URL=http://archon-os:8501/livez
AUTOHEAL_CONTAINER=ARCHON-OS
AUTOHEAL_INTERVAL_S=30
AUTOHEAL_FAILURES=5
AUTOHEAL_COOLDOWN_S=900
AUTOHEAL_PROBE_TIMEOUT_S=5
# 1 = Eingriff nur, wenn Docker den Container selbst als unhealthy markiert.
AUTOHEAL_HEALTH_GATE=1
# Maximales Alter des Watchdog-Heartbeats in /livez (loops.watchdog.last_seen),
# bevor der Probe als Fehlschlag gilt. Default 120 s (~4 Watchdog-Zyklen).
# Beide Schwellen werden in docker-compose.yml durchgereicht (Audit D10).
AUTOHEAL_WATCHDOG_MAX_AGE_S=120
# Selbe Schwelle im Watchdog-Daemon selbst. Nur gemeinsam mit der Autoheal-
# Schwelle erreichbar; bei Abweichung meldet /livez frueher als der Probe greift.
ARCHON_WATCHDOG_MAX_LAST_SEEN_AGE_S=120

# Litestream-Replikat: bewusst NICHT unter ./data — ein Verlust des DB-Volumes
# darf das Replikat nicht mitnehmen. Produktiv auf ein gemountetes externes
# Volume/NAS umstellen (im Ansible-Deploy: archon_litestream_replica_dir).
# RPO ~5-10 s (sync-interval). RTO-Ziel <= 30 min, messbar durch den
# periodischen Restore-Test (scripts/automated_restore_test.py, alle 6 h).
ARCHON_LITESTREAM_REPLICA_DIR=./dr_replicas
