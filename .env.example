# AgenticOS / Archon OS Environment Configuration
# Copy to .env and adjust variables to match your environment.

# Server & Networking
PORT=8420
HOST=0.0.0.0
BASE_URL=http://localhost:8420

# PocketBase (Default local instance on Port 8090)
POCKETBASE_URL=http://127.0.0.1:8090

# AI Provider / OmniRoute / LLM Hub
OMNIROUTE_URL=http://localhost:8000/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here

# Tool Execution & Integrations
COMPOSIO_API_KEY=your_composio_api_key_here

# Google Calendar Integration (Optional)
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_CALENDAR_ID=primary

# Telegram Bot Notification Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Local Service Integrations (Optional)
ANYTHINGLLM_URL=http://localhost:3001
N8N_URL=http://localhost:5678
