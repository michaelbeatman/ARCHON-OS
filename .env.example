# AgenticOS / Archon OS Environment Configuration
# Copy this file to .env and adjust variables to match your environment.
# CRITICAL: Never commit .env or files with real secrets to version control!

# Server & Networking
PORT=8501
HOST=0.0.0.0
BASE_URL=http://localhost:8501

# PocketBase (Default local instance on Port 8090)
POCKETBASE_URL=http://127.0.0.1:8090

# AI Provider / OmniRoute / LLM Hub (Port 20128)
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
HERMES_SESSION_TOKEN=your_hermes_session_token_here

# GitHub Token (for deployment sync and repo integration)
GITHUB_TOKEN=your_github_personal_access_token_here

# Tool Execution & Integrations
COMPOSIO_API_KEY=your_composio_api_key_here

# Google Calendar Integration (Optional)
GOOGLE_CREDENTIALS_FILE=data/secrets/google_credentials.json
GOOGLE_CALENDAR_ID=primary

# Telegram Bot Notification Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Local Service Integrations (Optional)
ANYTHINGLLM_URL=http://localhost:3001
# API-Key fuer den Vault->RAG-Sync (AnythingLLM). Pflicht, sobald der
# Hintergrund-Sync nach einem Library-Upload mit auto_ingest laufen soll:
# ohne Wert startet kein Sync (fail-fast, kein Default-Schluessel im Code).
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here
N8N_URL=http://localhost:5678
