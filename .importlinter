# S1 (God-Object-Zerlegung) — Import-Layer-Regel D09/H-09-2.
#
# Korrektur gegenueber der Vorgaenger-Config:
#   import-linter 2.17 kennt `root_packages` (Plural). `archon` und `backend`
#   sind ZWEI getrennte Top-Level-Pakete; `root_package = archon` (Singular)
#   machte `source_modules = backend` unauffindbar -> exit 1 /
#   "No matches for ignored import". Siehe ANALYSIS_GOD_OBJECTS.md §1.3.
#   Beide Pakete sind jetzt intern, daher include_external_packages = False.

[importlinter]
root_packages =
    archon
    backend
include_external_packages = False

[importlinter:contract:backend-no-router-imports]
name = backend darf archon.routers nicht importieren (Layergrenze D09/H-09-2)
type = forbidden
source_modules =
    backend
forbidden_modules =
    archon.routers
# D09-M2: allow_indirect_imports=false = STRENG. import-linter akzeptiert
# damit auch keine transitiven Pfade (z. B. backend.X -> archon.core.Y ->
# archon.routers.Z). Der fruehere Hinweis "nur direkte Importe" ist ueberholt:
# der archon-interne Pfad orchestration:1432 -> archon.routers.decisions ist
# seit A1 getilgt; archon/core/** enthaelt 0 Router-Importe.
# Das harte Gate ist jetzt ZWEIFACH: tests/test_import_layer_contracts.py
# (AST-SSOT) UND `lint-imports` hash-gepinnt aus requirements-ci.lock.txt,
# verdrahtet als harter Schritt in ci.yml. Kein stilles Aufweichen.
allow_indirect_imports = false

# Altschuld VOLLSTAENDIG getilgt (F5, 25.11.2026).
#   0 Importzeilen / 0 Modul-Paare / 0 backend-Module / 0 Ausnahmen.
#   Kette: 23 (S1) -> 21 (F1a) -> 18 (A1) -> 17 (A2) -> 3 (F4: 14
#   operations_*-Router-Registrierungen nach archon/routers/operations/)
#   -> 0 (F2: _rbac / auth / chat) -> F5: ignore_imports leer.
#   Der transitive Pfad orchestration:1432 -> archon.routers.decisions ist
#   seit A1 aufgeloest; archon/core/** enthaelt 0 Router-Importe.
#   NEUE Importe backend -> archon.routers sind ab sofort ein Verstoss
#   (Ratchet; allow_indirect_imports=false = streng transitiv).
#   tests/test_import_layer_contracts.py liest diese Datei als AST-SSOT und
#   enforced sie in CI. D09-M2 ergaenzt den echten `lint-imports`-Gate aus
#   requirements-ci.lock.txt: BEIDE Contracts werden jetzt inkl. transitiver
#   Kanten geprueft (kein "lokales Tool" mehr, kein Theater).
ignore_imports =

# A2 / Invariante #2: archon.core kennt keine HTTP-Schicht. 0 direkte Treffer
# (verifiziert gegen archon/core/**). D09-M2: der Contract ist jetzt STRENG
# (allow_indirect_imports=false) und laeuft im selben `lint-imports`-Gate wie
# der backend-Contract. Von archon.core fuehrt kein Pfad ueber archon.services
# nach archon.routers (archon/core/** importiert weder archon.services noch
# archon.routers). Negativprobe: siehe tests/test_w6_e_ci.py.
[importlinter:contract:core-no-router-imports]
name = archon.core darf archon.routers nicht importieren (Invariante #2)
type = forbidden
source_modules =
    archon.core
forbidden_modules =
    archon.routers
allow_indirect_imports = false
