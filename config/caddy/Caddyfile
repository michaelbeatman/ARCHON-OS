# config/caddy/Caddyfile
# Zentraler Reverse Proxy mit TLS, SSO/Forward-Auth und Routing für Archon OS 2026

{
    admin off
    auto_https off
}

# Primärer Gateway-Host (Port 80 / 443)
:80 {
    # Logging
    log {
        output stdout
        format console
        level INFO
    }

    # Sicherheits-Header (Zero Trust)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Öffentliche Endpunkte (Healthchecks & Prometheus Scrapes ohne Auth)
    @public {
        path /health /metrics /api/operations/metrics
    }
    handle @public {
        reverse_proxy archon-os:8501
    }

    # SSO / Authelia Authentifizierungs-Portal
    handle_path /authelia* {
        reverse_proxy authelia:9091
    }

    # Geschützte Sub-Dienste (mit Forward-Auth Hook bei Bedarf)
    # 1. Hermes Agenten-Gateway
    handle_path /hermes* {
        reverse_proxy hermes:8644
    }

    # 2. n8n Workflow-Mesh
    handle_path /n8n* {
        reverse_proxy n8n:5678
    }

    # 3. PocketBase CRM & Collections
    handle_path /pb* {
        reverse_proxy pocketbase:8090
    }

    # 4. OmniRoute Multi-Provider LLM Gateway
    handle_path /omniroute* {
        reverse_proxy omniroute:20128
    }

    # 5. Monitoring: Grafana
    handle_path /grafana* {
        reverse_proxy grafana:3000
    }

    # 6. Monitoring: Prometheus
    handle_path /prometheus* {
        reverse_proxy prometheus:9090
    }

    # 7. Monitoring: Uptime Kuma
    handle_path /uptime* {
        reverse_proxy uptime-kuma:3001
    }

    # 8. Standard-Routing: Archon OS Kernanwendung
    handle {
        reverse_proxy archon-os:8501
    }
}
