{
  "manifest_version": 3,
  "name": "Archon CRM - LinkedIn Connector",
  "version": "1.0.0",
  "description": "LinkedIn Profildaten direkt im Archon CRM (PocketBase) speichern",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8090/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Archon CRM Sync"
  }
}
