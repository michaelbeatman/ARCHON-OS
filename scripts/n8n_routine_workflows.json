[
  {
    "id": "b1c3f1e9b2d84f11",
    "name": "Archon Morning-Briefing Routine",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "30 7 * * 1-5"
              }
            ]
          }
        },
        "id": "cron-briefing",
        "name": "Schedule (07:30 Mo-Fr)",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          -80
        ]
      },
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "archon-morning-briefing",
          "responseMode": "lastNode",
          "options": {}
        },
        "id": "wh-briefing",
        "name": "Webhook On-Demand",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          100
        ],
        "webhookId": "archon-morning-briefing"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://ARCHON-OS:8501/api/system/standup/run",
          "sendBody": false,
          "options": {},
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Archon-Service-Token",
                "value": "__ARCHON_SERVICE_TOKEN__"
              }
            ]
          }
        },
        "id": "http-standup",
        "name": "Run Morning Standup",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          240,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://ARCHON-OS:8501/api/telegram/send",
          "sendBody": true,
          "specifyBody": "keypair",
          "bodyParameters": {
            "parameters": [
              {
                "name": "text",
                "value": "={{ $json.briefing_markdown }}"
              }
            ]
          },
          "options": {},
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Archon-Service-Token",
                "value": "__ARCHON_SERVICE_TOKEN__"
              }
            ]
          }
        },
        "id": "http-telegram",
        "name": "Send Telegram Briefing",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          0
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "m1",
                "name": "status",
                "value": "success",
                "type": "string"
              },
              {
                "id": "m2",
                "name": "routine",
                "value": "morning_briefing",
                "type": "string"
              },
              {
                "id": "m3",
                "name": "date",
                "value": "={{ $json.date }}",
                "type": "string"
              },
              {
                "id": "m4",
                "name": "message",
                "value": "Morning-Briefing erfolgreich generiert und verteilt.",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "set-briefing",
        "name": "Format Response",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          720,
          0
        ]
      }
    ],
    "connections": {
      "Schedule (07:30 Mo-Fr)": {
        "main": [
          [
            {
              "node": "Run Morning Standup",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Webhook On-Demand": {
        "main": [
          [
            {
              "node": "Run Morning Standup",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Run Morning Standup": {
        "main": [
          [
            {
              "node": "Send Telegram Briefing",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Send Telegram Briefing": {
        "main": [
          [
            {
              "node": "Format Response",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  },
