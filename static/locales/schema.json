  "definitions": {
    "message": {
      "description": "Ein Blatt: nicht-leerer String oder Plural-Objekt.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/definitions/plural"
        }
      ]
    },
    "plural": {
      "description": "Plural-Nachricht: Objekt ausschliesslich aus CLDR-Kategorien one/few/many/other, je Kategorie ein nicht-leerer String. Die Sprache fuehrt nur die Kategorien, die CLDR fuer sie kennt (siehe x-archon-plural.categories).",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(one|few|many|other)$": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "x-archon-plural": {
    "rule": "Plural-Nachrichten werden in Etappe 3 als Objekt unter dem Nachrichten-Schluessel gefuehrt: {\"one\": \"...\", \"other\": \"...\"}. Die Suffixe _one/_few/_many/_other sind als Schluessel-Endungen reserviert (flache Schreibweise) und duerfen nicht als eigene Nachricht angelegt werden; Pluralitaet wird nie per count === 1 ? a : b im Code geloest.",
    "suffixes": [
      "_one",
      "_few",
      "_many",
      "_other"
    ],
    "key_suffix_pattern": "_(one|few|many|other)$",
    "categories": {
      "de": [
        "one",
        "other"
      ],
      "en": [
        "one",
        "other"
      ],
      "es": [
        "one",
        "many",
        "other"
